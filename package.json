{
  "name": "innerworld",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "start:host": "node --env-file-if-exists=.env server.js --host",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/app.js && node --check src/core.js && node --check server.js",
    "e2e": "node tests/e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}

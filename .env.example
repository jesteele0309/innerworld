# Local development only. Never put this key into client JavaScript.
#
# INNERWORLD paints on your device by default and needs none of this. Set a key
# only if you want the option of painting with an image model instead; the
# model receives the question, the palette and the mark style, never your words.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
PORT=3000

# Set to "lan" to answer on this machine's private network address as well as
# localhost, so you can open the app on a phone. Same as `npm start -- --host`.
# Development only — never expose this server publicly.
INNERWORLD_HOST=
